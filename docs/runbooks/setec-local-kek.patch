+// localKEK loads a Tink AEAD keyset from path, creating a fresh AES-256-GCM
+// keyset there on first use. The keyset is stored cleartext: protection relies
+// on disk encryption (FileVault) and file permissions (0600), so there is no
+// passphrase or cloud KMS to bootstrap. Intended for a single self-hosted node.
+func localKEK(path string) (tink.AEAD, error) {
+	if b, err := os.ReadFile(path); err == nil {
+		kh, err := insecurecleartextkeyset.Read(keyset.NewJSONReader(bytes.NewReader(b)))
+		if err != nil {
+			return nil, fmt.Errorf("reading local KEK keyset %q: %w", path, err)
+		}
+		return aead.New(kh)
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("opening local KEK keyset %q: %w", path, err)
+	}
+
+	kh, err := keyset.NewHandle(aead.AES256GCMKeyTemplate())
+	if err != nil {
+		return nil, fmt.Errorf("generating local KEK: %w", err)
+	}
+	var buf bytes.Buffer
+	if err := insecurecleartextkeyset.Write(kh, keyset.NewJSONWriter(&buf)); err != nil {
+		return nil, fmt.Errorf("serialising local KEK: %w", err)
+	}
+	if err := os.WriteFile(path, buf.Bytes(), 0600); err != nil {
+		return nil, fmt.Errorf("writing local KEK keyset %q: %w", path, err)
+	}
+	log.Printf("local KEK: generated new AES-256-GCM keyset at %q", path)
+	return aead.New(kh)
+}
